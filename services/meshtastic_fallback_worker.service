[Unit]
Description=Meshtastic fallback command worker (MESH_ONLY control-plane)
After=telemetry_collector_head.service
Requires=telemetry_collector_head.service

[Service]
Type=oneshot
User=pump
Group=pump
Environment=OUT_DIR=/home/pump/telemetry_head
Environment=FALLBACK_COMMAND_QUEUE=/home/pump/telemetry_head/fallback_commands.jsonl
Environment=CONNECTIVITY_MODE_FILE=/home/pump/telemetry_head/connectivity_mode.state
Environment=MESHTASTIC_NODE_MAP_FILE=/home/pump/telemetry_head/meshtastic_node_map.json
Environment=COLLECTOR_IPC_SOCKET=/run/manet/collector.sock
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/manet/head.env
ExecStart=/usr/bin/python3 /opt/manet/head/scripts/meshtastic_fallback_worker.py --once
RuntimeDirectory=manet
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0077
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pump/telemetry_head /run/manet
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
