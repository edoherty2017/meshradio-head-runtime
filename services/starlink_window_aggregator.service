[Unit]
Description=Starlink 60-second tumbling-window aggregator
After=starlink_raw_poller.service
Requires=starlink_raw_poller.service

[Service]
Type=simple
User=pump
Group=pump
Environment=OUT_DIR=/home/pump/telemetry_head
Environment=TRIAL_ID=trial-live
Environment=NODE_ID=meshradiohead2
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/manet/head.env
ExecStart=/usr/bin/python3 /opt/manet/head/scripts/starlink_window_aggregator.py
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pump/telemetry_head
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
