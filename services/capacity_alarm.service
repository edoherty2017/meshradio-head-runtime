[Unit]
Description=HEAD disk/inode capacity alarm (structured JSON events)
After=telemetry_collector_head.service

[Service]
Type=oneshot
User=pump
Group=pump
Environment=OUT_DIR=/home/pump/telemetry_head
Environment=CAPACITY_WARN_PERCENT=80
Environment=CAPACITY_CRITICAL_PERCENT=90
Environment=CAPACITY_MIN_FREE_BYTES=536870912
Environment=CAPACITY_ALARM_EVENTS=/home/pump/telemetry_head/capacity_alarm_events.jsonl
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/manet/head.env
# Exit status encodes worst severity (0 OK / 1 WARN / 2 CRITICAL); do not let a
# non-zero alarm mark the unit failed — the JSON events are the signal.
SuccessExitStatus=0 1 2
ExecStart=/usr/bin/python3 /opt/manet/head/scripts/capacity_alarm.py \
    --path ${OUT_DIR} \
    --warn-percent ${CAPACITY_WARN_PERCENT} \
    --critical-percent ${CAPACITY_CRITICAL_PERCENT} \
    --min-free-bytes ${CAPACITY_MIN_FREE_BYTES} \
    --out ${CAPACITY_ALARM_EVENTS}
UMask=0077
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pump/telemetry_head
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
